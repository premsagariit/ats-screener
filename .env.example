# Copy to .env and fill in. Read by app.py and cli.py (never commit .env).

# anthropic | openai | gemini | compatible | mock
LLM_PROVIDER=anthropic

# Leave empty to use the provider default (e.g. claude-haiku-5-5)
LLM_MODEL=claude-sonnet-5-5

# API key for the provider above (not needed for mock; optional for local compatible servers)
LLM_API_KEY=

# Only for LLM_PROVIDER=compatible (Ollama, vLLM, Groq...), e.g. http://localhost:11434/v1
LLM_BASE_URL=

# Concurrent requests (1-32). Lower it if you hit 429 rate limits.
LLM_CONCURRENCY=8


LLM_SAMPLES=1
LLM_RPM=1000
LLM_ITPM=500000
LLM_OTPM=80000